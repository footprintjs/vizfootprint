{
  "name": "vizfootprint-studio",
  "version": "0.0.0",
  "private": true,
  "description": "The installable cockpit for vizfootprint — `desk`, a whole provenance dashboard (time strip, charts band, editor, notes, panels, story) driven by one session view and parameterised by a definition. Part of the footprintjs family.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./desk": {
      "types": "./types/desk/index.d.ts",
      "import": "./dist/desk.js",
      "default": "./dist/desk.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "types",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "storydeck": "*",
    "vizfootprint": "*",
    "vizfootprint-ui": "*"
  },
  "peerDependenciesMeta": {
    "storydeck": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storydeck": "file:../../storydeck",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0",
    "vizfootprint": "file:..",
    "vizfootprint-ui": "0.0.0"
  }
}
