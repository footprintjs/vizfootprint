{
  "name": "vizfootprint",
  "version": "0.0.0",
  "private": true,
  "description": "Causal/agent provenance layer for coordinated interactive visualization — cause-tagged clauses over Mosaic, append-only branching provenance, declared analyses with online FDR. Part of the footprintjs family.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "tsc -p demo/tsconfig.json --noEmit",
    "typecheck:demo-agent": "tsc -p demo-agent/tsconfig.json --noEmit",
    "demo": "node demo/server.mjs",
    "demo:data": "node demo/gen-data.mjs",
    "demo:agent": "node demo-agent/server.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@trrack/core": "^1.6.1",
    "@types/node": "^22.0.0",
    "@uwdata/mosaic-spec": "^0.28.1",
    "agentfootprint": "^7.4.0",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.58.2",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@uwdata/mosaic-core": "^0.28.1",
    "footprintjs": "^9.11.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
