{
  "name": "vizfootprint",
  "version": "0.0.0",
  "private": true,
  "description": "Causal/agent provenance layer for coordinated interactive visualization — cause-tagged clauses over Mosaic, append-only branching provenance, declared analyses with online FDR. Part of the footprintjs family.",
  "type": "module",
  "license": "MIT",
  "workspaces": [
    "ui",
    "bridges/vega-lite"
  ],
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "tsc -p demo/tsconfig.json --noEmit",
    "typecheck:demo-agent": "tsc -p demo-agent/tsconfig.json --noEmit",
    "demo": "node demo/server.mjs",
    "demo:data": "node demo/gen-data.mjs",
    "demo:agent": "node demo-agent/server.mjs",
    "demo:agent:data": "node demo-agent/gen-data.mjs",
    "build:ui": "npm run build -w vizfootprint-ui",
    "test:ui": "npm run test -w vizfootprint-ui",
    "typecheck:ui": "npm run typecheck -w vizfootprint-ui",
    "typecheck:vega-lite": "npm run typecheck -w vizfootprint-vega-lite",
    "test:vega-lite": "npm run test -w vizfootprint-vega-lite",
    "gallery:ui": "npm run gallery -w vizfootprint-ui"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@trrack/core": "^1.6.1",
    "@types/node": "^22.0.0",
    "@uwdata/mosaic-spec": "^0.28.1",
    "@vitest/coverage-v8": "^4.1.10",
    "agentfootprint": "^7.4.0",
    "agentthinkingui": "^0.23.0",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@uwdata/mosaic-core": "^0.28.1",
    "@uwdata/mosaic-sql": "^0.28.1",
    "footprintjs": "^9.11.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
