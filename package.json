{
  "name": "vizfootprint",
  "version": "0.1.0",
  "private": true,
  "description": "Causal/agent provenance layer for coordinated interactive visualization \u2014 cause-tagged clauses over Mosaic, append-only branching provenance, declared analyses with online FDR. Part of the footprintjs family.",
  "type": "module",
  "license": "MIT",
  "types": "./dist/agent/index.d.ts",
  "module": "./dist/agent/index.js",
  "main": "./dist/agent/index.js",
  "exports": {
    ".": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./session": {
      "types": "./dist/session/index.d.ts",
      "default": "./dist/session/index.js"
    },
    "./def": {
      "types": "./dist/def/index.d.ts",
      "default": "./dist/def/index.js"
    },
    "./analysis": {
      "types": "./dist/analysis/index.d.ts",
      "default": "./dist/analysis/index.js"
    },
    "./source": {
      "types": "./dist/source/index.d.ts",
      "default": "./dist/source/index.js"
    },
    "./source/file": {
      "types": "./dist/source/file.d.ts",
      "default": "./dist/source/file.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "default": "./dist/data/index.js"
    },
    "./cause": {
      "types": "./dist/cause/index.d.ts",
      "default": "./dist/cause/index.js"
    },
    "./mosaic": {
      "types": "./dist/mosaic/index.d.ts",
      "default": "./dist/mosaic/index.js"
    },
    "./prose": {
      "types": "./dist/prose/index.d.ts",
      "default": "./dist/prose/index.js"
    },
    "./log": {
      "types": "./dist/log/index.d.ts",
      "default": "./dist/log/index.js"
    },
    "./branches": {
      "types": "./dist/branches/index.d.ts",
      "default": "./dist/branches/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "PACKAGING.md"
  ],
  "sideEffects": false,
  "workspaces": [
    "ui",
    "bridges/vega-lite"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:demo": "tsc -p demo/tsconfig.json --noEmit",
    "typecheck:demo-agent": "tsc -p demo-agent/tsconfig.json --noEmit",
    "demo": "node demo/server.mjs",
    "demo:data": "node demo/gen-data.mjs",
    "demo:agent": "node demo-agent/server.mjs",
    "demo:agent:data": "node demo-agent/gen-data.mjs",
    "build:ui": "npm run build -w vizfootprint-ui",
    "test:ui": "npm run test -w vizfootprint-ui",
    "typecheck:ui": "npm run typecheck -w vizfootprint-ui",
    "typecheck:vega-lite": "npm run typecheck -w vizfootprint-vega-lite",
    "test:vega-lite": "npm run test -w vizfootprint-vega-lite",
    "gallery:ui": "npm run gallery -w vizfootprint-ui",
    "bench:surface": "node bench/surface/run.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@trrack/core": "^1.6.1",
    "@types/node": "^22.0.0",
    "@uwdata/mosaic-spec": "^0.28.1",
    "@vitest/coverage-v8": "^4.1.10",
    "agentfootprint": "^9.82.0",
    "agentthinkingui": "^0.23.0",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.58.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.0",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@uwdata/mosaic-core": "^0.28.1",
    "@uwdata/mosaic-sql": "^0.28.1",
    "footprintjs": "^9.11.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.0.0",
    "agentfootprint": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "agentfootprint": {
      "optional": true
    }
  }
}
